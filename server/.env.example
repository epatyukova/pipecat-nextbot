# pipecat-nextbot - Environment Variables
# Add these variables to the repository root .env or export them in your shell.


# Cartesia (speech synthesis; voice override is optional)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (speech recognition)
DEEPGRAM_API_KEY=


# OpenAI (language model; model override is optional)
OPENAI_API_KEY=
OPENAI_MODEL=
